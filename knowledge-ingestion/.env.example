# Copy to .env and fill in. Never commit .env.

# HubSpot developer test account ID (not a secret, but keep it configurable)
HUBSPOT_PORTAL_ID=

# HubSpot private app access token (starts with pat-). SECRET.
HUBSPOT_ACCESS_TOKEN=

# Database URL in SQLAlchemy format. Supported drivers: postgresql+psycopg, mssql+pyodbc, sqlite.
# Percent-encode special characters in the password (for example @ becomes %40).
# Local SQL Server from docker-compose.yml (TrustServerCertificate is only for local self-signed certs):
DATABASE_URL=mssql+pyodbc://sa:CHANGE_ME@localhost:1433/knowledge?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes&Encrypt=yes
# Azure SQL example (no TrustServerCertificate):
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@YOUR-SERVER.database.windows.net:1433/knowledge?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes

# Background polling of HubSpot (optional). Interval is in seconds, minimum 30.
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=300

# Publishing sync events to the backend (optional). Leave BACKEND_EVENTS_URL empty to turn publishing off.
# The secret must match BACKEND_EVENT_SECRET in the backend service. SECRET.
BACKEND_EVENTS_URL=
BACKEND_EVENT_SECRET=
# Must match the tenant and source registered in the backend. The database ID is optional.
BACKEND_TENANT_ID=default
BACKEND_SOURCE_ID=hubspot
BACKEND_DATABASE_ID=

# Password for the local SQL Server container. Used only by docker-compose.yml.
