# Copy to .env (gitignored) and fill in. Every value is optional: without LLM credentials the
# engine runs in a labelled deterministic offline mode.

# --- Microsoft Foundry (one resource serves all three agents) ---
BACKEND_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com
BACKEND_FOUNDRY_API_KEY=
# Deployment names per role (defaults shown). Claude models use the Anthropic Messages route, GPT models the OpenAI route.
# Both investigating agents use the strongest model; structured output (adjudicator verdicts) uses OpenAI.
BACKEND_EXPLORER_LLM_MODEL=claude-opus-4-6
BACKEND_HERCULES_LLM_MODEL=claude-opus-4-6
BACKEND_STRUCTURED_LLM_MODEL=gpt-5.6-sol
# BACKEND_ADJUDICATOR_LLM_MODEL=     # inherits BACKEND_STRUCTURED_LLM_* when unset
BACKEND_LIGHT_LLM_MODEL=claude-sonnet-5
# Optional pricing so per-run cost is reported instead of $0
# BACKEND_EXPLORER_LLM_INPUT_COST_PER_MTOK=
# BACKEND_EXPLORER_LLM_OUTPUT_COST_PER_MTOK=
# auto (LLM when configured) | offline | llm
BACKEND_REASONING_MODE=auto

# --- Data / knowledge stores (embedded Postgres 16 + pgvector starts automatically when unset) ---
# BACKEND_PG_URI=postgresql://user:pass@host:5432

# --- Sync events from the ingestion service ---
# Shared HMAC secret; events must carry X-Backend-Signature: hex(HMAC-SHA256(secret, raw body)).
BACKEND_EVENT_SECRET=change-me
# BACKEND_EVENT_ALLOW_UNSIGNED=1   # local development only
BACKEND_EVENT_WORKER=1
# BACKEND_EVENT_POLL_S=1.0
# BACKEND_EVENT_LOOKBACK_S=300
# JSON policy file: timestamp columns, watched analyses, Stage B triggers (see docs/RUNTIME.md)
# BACKEND_RUNTIME_POLICY=config/runtime_policy.json
BACKEND_AUTO_ANALYSIS=0
BACKEND_RETRY_ON_VERSION_CHANGE=1

# --- Code sandboxes: off | local (subprocess, NOT a security boundary) | daytona ---
BACKEND_SANDBOX=off
# DAYTONA_API_KEY=
# DAYTONA_API_URL=
# DAYTONA_TARGET=

# --- Files / API ---
# BACKEND_FILE_STORE=data/file_store
# BACKEND_MAX_UPLOAD_MB=500
# Any localhost port is allowed by default (BACKEND_CORS_ORIGIN_REGEX); add deployed origins here
# BACKEND_CORS_ORIGINS=https://backend.example.com
