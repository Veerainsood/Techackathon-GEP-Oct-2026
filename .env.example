# Copy to .env (gitignored) and fill in. Every value is optional: without LLM credentials the
# engine runs in a labelled deterministic offline mode.

# --- Microsoft Foundry (one resource serves all three agents) ---
UDRE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com
UDRE_FOUNDRY_API_KEY=
# Deployment names per role (defaults shown). Claude models use the Anthropic Messages route, GPT models the OpenAI route.
# Both investigating agents use the strongest model; structured output (adjudicator verdicts) uses OpenAI.
UDRE_EXPLORER_LLM_MODEL=claude-opus-4-6
UDRE_HERCULES_LLM_MODEL=claude-opus-4-6
UDRE_STRUCTURED_LLM_MODEL=gpt-5.6-sol
# UDRE_ADJUDICATOR_LLM_MODEL=     # inherits UDRE_STRUCTURED_LLM_* when unset
UDRE_LIGHT_LLM_MODEL=claude-sonnet-5
# Optional pricing so per-run cost is reported instead of $0
# UDRE_EXPLORER_LLM_INPUT_COST_PER_MTOK=
# UDRE_EXPLORER_LLM_OUTPUT_COST_PER_MTOK=
# auto (LLM when configured) | offline | llm
UDRE_REASONING_MODE=auto

# --- Data / knowledge stores (embedded Postgres 16 + pgvector starts automatically when unset) ---
# UDRE_PG_URI=postgresql://user:pass@host:5432

# --- Sync events from the ingestion service ---
# Shared HMAC secret; events must carry X-UDRE-Signature: hex(HMAC-SHA256(secret, raw body)).
UDRE_EVENT_SECRET=change-me
# UDRE_EVENT_ALLOW_UNSIGNED=1   # local development only
UDRE_EVENT_WORKER=1
# UDRE_EVENT_POLL_S=1.0
# UDRE_EVENT_LOOKBACK_S=300
# JSON policy file: timestamp columns, watched analyses, Stage B triggers (see docs/RUNTIME.md)
# UDRE_RUNTIME_POLICY=config/runtime_policy.json
UDRE_AUTO_ANALYSIS=0
UDRE_RETRY_ON_VERSION_CHANGE=1

# --- Code sandboxes: off | local (subprocess, NOT a security boundary) | daytona ---
UDRE_SANDBOX=off
# DAYTONA_API_KEY=
# DAYTONA_API_URL=
# DAYTONA_TARGET=

# --- Files / API ---
# UDRE_FILE_STORE=data/file_store
# UDRE_MAX_UPLOAD_MB=500
# Any localhost port is allowed by default (UDRE_CORS_ORIGIN_REGEX); add deployed origins here
# UDRE_CORS_ORIGINS=https://udre.example.com
