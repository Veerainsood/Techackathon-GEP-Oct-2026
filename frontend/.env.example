# live (default): talks to the FastAPI backend. demo: the original static mockup with scripted data.
VITE_BACKEND_MODE=live
VITE_BACKEND_API=http://localhost:8000
# Sent as X-Tenant-Id / X-User-Id headers (overridable in localStorage: backend.tenant / backend.user)
VITE_BACKEND_TENANT=default
VITE_BACKEND_USER=analyst
