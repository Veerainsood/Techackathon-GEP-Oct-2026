# live (default): talks to the FastAPI backend. demo: the original static mockup with scripted data.
VITE_UDRE_MODE=live
VITE_UDRE_API=http://localhost:8000
# Sent as X-Tenant-Id / X-User-Id headers (overridable in localStorage: udre.tenant / udre.user)
VITE_UDRE_TENANT=default
VITE_UDRE_USER=analyst
