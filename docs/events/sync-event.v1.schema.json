{
  "$defs": {
    "CollectionChange": {
      "properties": {
        "name": {
          "description": "Collection/table name as exposed by the source (schema-qualified for SQL sources)",
          "title": "Name",
          "type": "string"
        },
        "timestamp_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Column that records modification time in this collection",
          "title": "Timestamp Column"
        },
        "status": {
          "default": "completed",
          "enum": [
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected_changes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rows the producer wrote in the window (visibility check)",
          "title": "Expected Changes"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/RecordChange"
          },
          "title": "Changes",
          "type": "array"
        },
        "schema_changed": {
          "default": false,
          "title": "Schema Changed",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "name"
      ],
      "title": "CollectionChange",
      "type": "object"
    },
    "RecordChange": {
      "description": "One CDC change, when the producer can provide it.",
      "properties": {
        "op": {
          "enum": [
            "insert",
            "update",
            "delete"
          ],
          "title": "Op",
          "type": "string"
        },
        "key": {
          "additionalProperties": true,
          "description": "Primary-key column(s) -> value",
          "title": "Key",
          "type": "object"
        },
        "changed_columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed Columns"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Old values (only if the producer captured them)",
          "title": "Before"
        },
        "committed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Committed At"
        }
      },
      "required": [
        "op",
        "key"
      ],
      "title": "RecordChange",
      "type": "object"
    }
  },
  "properties": {
    "schema": {
      "default": "backend.sync-event.v1",
      "title": "Schema",
      "type": "string"
    },
    "event_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "database.sync.completed",
        "database.sync.failed",
        "knowledge.version.published"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "source_id": {
      "description": "Source as registered in the backend gateway",
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "database_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Database Id"
    },
    "collections": {
      "items": {
        "$ref": "#/$defs/CollectionChange"
      },
      "title": "Collections",
      "type": "array"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "data_version": {
      "minLength": 1,
      "title": "Data Version",
      "type": "string"
    },
    "sequence": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Monotonic per (tenant, source, database); defaults to digits of data_version",
      "title": "Sequence"
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Version"
    },
    "knowledge_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knowledge Version"
    },
    "commit_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit Id"
    },
    "status": {
      "default": "completed",
      "enum": [
        "completed",
        "failed",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the sync failed (database.sync.failed)",
      "title": "Error"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "producer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Producer"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "tenant_id",
    "source_id",
    "window_start",
    "window_end",
    "data_version"
  ],
  "title": "SyncEvent",
  "type": "object",
  "$id": "backend.sync-event.v1",
  "description": "Proposed event contract v1 between the ingestion/synchronization service and the agent runtime.\n\nPROPOSAL -- to be agreed with the ingestion engineer; the JSON Schema is exported to\n``docs/events/sync-event.v1.schema.json``.  Required fields are the minimum the runtime needs; optional\nfields make investigation precise (changed keys / CDC operations beat timestamp windows).\n\nDelivery and visibility rules the producer must honour:\n  * publish only after the database transaction(s) for the window are committed and visible to readers\n  * ``window_start`` / ``window_end`` are a half-open interval ``[start, end)`` on each collection's\n    ``timestamp_column``; consecutive syncs should share the boundary (end of one == start of the next)\n  * ``sequence`` (or the numeric part of ``data_version``) increases monotonically per (tenant, source, database)\n  * authenticity: HMAC-SHA256 of the raw body with the shared secret, hex in ``X-Backend-Signature``"
}